<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Oyun varlıkları ilk açılışta indirilir; sunucu yalnızca 127.0.0.1'de dinler -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ONR-03: üretim hazır, eğitim bitti, kalkan bitiyor, saldırı (yerel bildirim; Android 13+ izin ister) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/uygulama_adi"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Tema"
        android:networkSecurityConfig="@xml/ag_guvenligi"
        android:allowBackup="true"
        android:fullBackupContent="@xml/yedek_eski"
        android:dataExtractionRules="@xml/yedek"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Zamanı gelen bildirimi gösterir (Bildirimler.kur); başka uygulamalara kapalı -->
        <receiver
            android:name=".Bildirimler$Alici"
            android:exported="false" />
    </application>
</manifest>
