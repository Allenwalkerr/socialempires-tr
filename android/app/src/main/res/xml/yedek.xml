<?xml version="1.0" encoding="utf-8"?>
<!-- Android yedeğine yalnızca kayıtlar girer (indirilen ~60 MB varlık girmez, yeniden indirilir). Android 12+ -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="socialempires/saves/" />
        <exclude domain="file" path="socialempires/saves/backups/" />
        <!-- 14 günlük kopyalar Android'in 25 MB bulut yedeği sınırını bir haftada aşıp bütün yedeği düşürüyordu -->
        <exclude domain="file" path="socialempires/saves/gunluk_yedek/" />
        <!-- Sınırsız büyüyen günlükler yedeğe girmez (DGV-07). ayarlar.json (ev ağı parolası) dahil edilmez; dahil olmayan yolu dışlamak lint hatasıdır -->
        <exclude domain="file" path="socialempires/saves/komut_gunlugu.jsonl" />
        <exclude domain="file" path="socialempires/saves/komut_gunlugu.jsonl.1" />
        <exclude domain="file" path="socialempires/saves/http_gunlugu.jsonl" />
        <exclude domain="file" path="socialempires/saves/http_gunlugu.jsonl.1" />
        <exclude domain="file" path="socialempires/saves/istemci_hatalari.jsonl" />
        <exclude domain="file" path="socialempires/saves/istemci_hatalari.jsonl.1" />
        <exclude domain="file" path="socialempires/saves/sunucu_hatalari.log" />
        <exclude domain="file" path="socialempires/saves/sunucu_hatalari.log.1" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="socialempires/saves/" />
        <exclude domain="file" path="socialempires/saves/backups/" />
        <!-- 14 günlük kopyalar Android'in 25 MB bulut yedeği sınırını bir haftada aşıp bütün yedeği düşürüyordu -->
        <exclude domain="file" path="socialempires/saves/gunluk_yedek/" />
        <!-- Sınırsız büyüyen günlükler yedeğe girmez (DGV-07). ayarlar.json (ev ağı parolası) dahil edilmez; dahil olmayan yolu dışlamak lint hatasıdır -->
        <exclude domain="file" path="socialempires/saves/komut_gunlugu.jsonl" />
        <exclude domain="file" path="socialempires/saves/komut_gunlugu.jsonl.1" />
        <exclude domain="file" path="socialempires/saves/http_gunlugu.jsonl" />
        <exclude domain="file" path="socialempires/saves/http_gunlugu.jsonl.1" />
        <exclude domain="file" path="socialempires/saves/istemci_hatalari.jsonl" />
        <exclude domain="file" path="socialempires/saves/istemci_hatalari.jsonl.1" />
        <exclude domain="file" path="socialempires/saves/sunucu_hatalari.log" />
        <exclude domain="file" path="socialempires/saves/sunucu_hatalari.log.1" />
    </device-transfer>
</data-extraction-rules>
